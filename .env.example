# ─────────────────────────────────────────────────────────────────────────────
# WEBZIVO — ENVIRONMENT CONFIGURATION
#
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in the values below.
# 3. Restart the dev server after changing anything here.
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are embedded in the browser
# bundle and are PUBLIC. Never put secrets or API keys behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────


# ── SITE URL ─────────────────────────────────────────────────────────────────
# Your final production domain. Required for correct SEO, sitemap.xml,
# robots.txt and social share (Open Graph) links.
# Example: https://webzivo.com
NEXT_PUBLIC_SITE_URL=


# ── WHATSAPP ─────────────────────────────────────────────────────────────────
# OPTIONAL. Already defaults to 923239713406 (+92 323 971 3406), set as
# DEFAULT_WHATSAPP_NUMBER in src/config/site.ts. Set this only to override it.
#
# FORMAT: digits only — no +, no spaces, no dashes — and DROP the leading 0
# from the national part. It is the single most common mistake here:
#   Pakistan   0323 9713406  -> 923239713406   (NOT 9203239713406)
#   Kuwait     1234 5678     -> 96512345678
# A wa.me link built from a number with the trunk 0 still in it will not open.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ── CONTACT EMAIL ────────────────────────────────────────────────────────────
# OPTIONAL. The public address already defaults to webzivodesignz@gmail.com
# (set as DEFAULT_CONTACT_EMAIL in src/config/site.ts), so the site works
# without this. Set it here only to override that for a given environment --
# e.g. once you move to hello@webzivo.com on your own domain.
NEXT_PUBLIC_CONTACT_EMAIL=


# ── GOOGLE MAPS ──────────────────────────────────────────────────────────────
# Paste the share link from your Google Business Profile / Maps listing.
# The "Get Directions" button only appears once this is set.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Optional: street address shown under "Kuwait". Leave blank to show only the
# country. Example: Salmiya, Block 12, Kuwait
NEXT_PUBLIC_BUSINESS_ADDRESS=


# ── ANALYTICS (all optional — scripts only load when a value is present) ─────
# Google Analytics 4 measurement ID. Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID. Example: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML-tag verification code (the "content" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ── CONTACT FORM DELIVERY (server-side only — never exposed to browser) ──────
# The contact form validates on the server but does NOT send email until a
# provider is configured here. Until then the form tells visitors to use
# WhatsApp or email instead, rather than silently discarding their message.
#
# Default provider is Resend (https://resend.com) — free tier available.
#   1. Create an account and verify your sending domain.
#   2. Create an API key and paste it below.
#   3. Set the from/to addresses.
# To use a different provider (SendGrid, Postmark, SMTP, etc.) edit the
# sendEnquiryEmail() function in src/lib/email.ts
RESEND_API_KEY=

# Verified sender address. Must be on a domain you verified with the provider.
# Example: website@webzivo.com
CONTACT_FROM_EMAIL=

# Where enquiries are delivered. Defaults to the public contact address above.
CONTACT_TO_EMAIL=
