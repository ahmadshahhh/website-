# ─────────────────────────────────────────────────────────────────────────────
# WEBZIVO — ENVIRONMENT CONFIGURATION
#
# Everything here is OPTIONAL. The site ships with working defaults committed
# in src/config/site.ts, so it runs correctly with no .env file at all. Use
# this only to override a value for a particular deployment.
#
#   1. cp .env.example .env.local
#   2. Fill in only the lines you want to change.
#   3. Restart the dev server after editing.
#
# NOTE: variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle
# and are PUBLIC. Never put a private key behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────


# ── SITE URL ─────────────────────────────────────────────────────────────────
# Defaults to https://webzivo-kw.vercel.app. Set this once a custom domain
# replaces it — it drives canonical URLs, sitemap.xml, robots.txt and the
# social share image, so a wrong value breaks SEO and link previews.
NEXT_PUBLIC_SITE_URL=


# ── WHATSAPP ─────────────────────────────────────────────────────────────────
# Defaults to 96594986039 (+965 9498 6039).
#
# FORMAT: digits only — no +, no spaces, no dashes — and DROP the leading 0
# from the national part:
#   Kuwait   9498 6039  ->  96594986039
# A wa.me link built from a number that still has the trunk 0 will not open.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ── CONTACT EMAIL ────────────────────────────────────────────────────────────
# Defaults to webzivodesignz@gmail.com. Shown in the contact card and footer.
NEXT_PUBLIC_CONTACT_EMAIL=


# ── GOOGLE MAPS ──────────────────────────────────────────────────────────────
# Defaults to the Webzivo Mangaf listing. Every "Mangaf, Kuwait" link on the
# site opens this. The embedded map in the contact card is separate and is set
# as MAPS_EMBED_URL in src/config/site.ts.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Optional street address, shown above the location. Blank shows only the area.
NEXT_PUBLIC_BUSINESS_ADDRESS=


# ── CONTACT FORM DELIVERY ────────────────────────────────────────────────────
# The form posts to Web3Forms, which emails submissions to the inbox the
# access key is registered to. A working key is already committed, so the form
# works with no setup.
#
# IMPORTANT: Web3Forms decides the destination from the key itself — there is
# no "send to" field. To change where enquiries land, create a new key at
# https://web3forms.com using that address and set it here.
#
# This has no NEXT_PUBLIC_ prefix, so it is only ever read on the server.
WEB3FORMS_ACCESS_KEY=


# ── ANALYTICS (all optional — scripts only load when a value is present) ─────
# Google Analytics 4 measurement ID. Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID. Example: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML-tag verification code (the "content" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
